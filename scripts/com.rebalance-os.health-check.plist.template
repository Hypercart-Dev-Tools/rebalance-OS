<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rebalance-os.health-check</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON}}</string>
        <string>{{REBALANCE_DIR}}/scripts/health_issue_reporter.py</string>
        <!-- FAIL-only, no LLM — runs every hour, cheap and fast -->
        <string>--close</string>
    </array>

    <!-- Every hour on the hour -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>10</integer></dict>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- GitHub token is in the rebalance config, but add it here too
             so launchd's minimal environment can find it if needed. -->
        <!-- <key>GEMINI_API_KEY</key><string>AIzaSy...</string> -->
    </dict>

    <key>StandardOutPath</key>
    <string>{{REBALANCE_DIR}}/temp/logs/health-check-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>{{REBALANCE_DIR}}/temp/logs/health-check-stderr.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
