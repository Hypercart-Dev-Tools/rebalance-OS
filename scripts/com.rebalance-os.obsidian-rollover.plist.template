<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rebalance-os.obsidian-rollover</string>

    <!-- Run through a /bin/bash wrapper, NOT python3 directly: a directly-launched
         interpreter is denied access to ~/Documents (TCC), but the bash wrapper
         inherits the existing Full Disk Access grant used by the other rebalance
         jobs — so no new Full Disk Access entry is needed. -->
    <key>ProgramArguments</key>
    <array>
        <string>{{REBALANCE_DIR}}/utils/obsidian_rollover.sh</string>
    </array>

    <!-- Fire at 00:00 every day. If the Mac is asleep at midnight, launchd
         runs the job as soon as it next wakes. -->
    <!-- 00:40, not 00:00 (GH-175 finding 3): midnight collided with the hourly
         pulse-sync. Still comfortably inside the same calendar day. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>0</integer>
        <key>Minute</key>
        <integer>40</integer>
    </dict>

    <!-- IMPORTANT: must stay false. RunAtLoad would fire the rollover the
         moment this plist loads and wipe Today's Notes unexpectedly. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Log lives OUTSIDE ~/Documents: that folder is TCC-protected and launchd
         can't open files there without Full Disk Access. ~/Library/Logs is fine. -->
    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Logs/rebalance-os/obsidian-rollover.log</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/rebalance-os/obsidian-rollover.log</string>
</dict>
</plist>
