<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rebalance-os.pulse-server</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{REBALANCE_DIR}}/scripts/pulse_server.sh</string>
    </array>

    <!-- Long-running FastAPI server on 127.0.0.1:8767 -->
    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>WorkingDirectory</key>
    <string>{{REBALANCE_DIR}}</string>

    <key>StandardOutPath</key>
    <string>{{REBALANCE_DIR}}/temp/logs/pulse_server_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>{{REBALANCE_DIR}}/temp/logs/pulse_server_stderr.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
