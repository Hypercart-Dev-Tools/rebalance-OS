<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rebalance-os.git-pulse-daily-synthesis</string>

    <!-- Run through a /bin/bash wrapper, NOT python3 directly: the optional
         Obsidian vault write needs the Full Disk Access grant the bash wrapper
         inherits (see utils/git_pulse_daily_synthesis.sh for why). -->
    <key>ProgramArguments</key>
    <array>
        <string>{{REBALANCE_DIR}}/utils/git_pulse_daily_synthesis.sh</string>
    </array>

    <!-- Fire at 18:05 — 5 minutes after obsidian-daily-sync (GH-112, 18:00), so
         when both destinations are configured this block lands after the GH-112
         AI Daily Summary block, per the GH-114 design contract. If the Mac is
         asleep at 18:05, launchd runs the job as soon as it next wakes — the
         script's own late-run guard skips any catch-up that fires after
         midnight (past the 00:00 rollover). -->
    <!-- 18:30, moved with obsidian-daily-sync (18:00->18:20) in GH-175.
         ORDERING DEPENDENCY: must fire AFTER obsidian-daily-sync so, when both
         destinations are configured, this block lands after the GH-112 AI Daily
         Summary block. Do not move either job without the other. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- Stay false: loading should not fire an off-schedule summary write. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Log lives OUTSIDE ~/Documents: that folder is TCC-protected and launchd
         can't open files there without Full Disk Access. ~/Library/Logs is fine. -->
    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Logs/rebalance-os/git-pulse-daily-synthesis.log</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/rebalance-os/git-pulse-daily-synthesis.log</string>
</dict>
</plist>
