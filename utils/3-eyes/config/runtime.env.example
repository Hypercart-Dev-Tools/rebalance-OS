# 3-Eyes runtime activation (GH-195) — COPY to runtime.env to opt in.
#
#     cp config/runtime.env.example config/runtime.env
#     # edit, then set THREE_EYES_ENABLE=1
#
# runtime.env is gitignored. Its mere ABSENCE is what keeps a downstream clone
# inert: with no runtime.env, three_eyes_active() is False and 3-Eyes makes zero
# network / ollama / gh / launchd / cron calls. This is the "call home is
# definitely off by default" guarantee — nothing here ships enabled.

# The master switch. 0 (or unset / no runtime.env) = fully inert. 1 = active.
THREE_EYES_ENABLE=0

# Ollama model for the classifier (see three_eyes/classify.py). Local only.
THREE_EYES_MODEL=gemma4:12b-mlx

# GitHub repo for the gh-issue route (only used when a job routes to gh-issue).
THREE_EYES_GH_REPO=Hypercart-Dev-Tools/rebalance-OS

# Optional: override where mutable run-state lives (locks, breaker counters).
# Defaults to ~/.cache/rebalance-os/3-eyes.
# THREE_EYES_STATE_DIR=/Users/you/.cache/rebalance-os/3-eyes
