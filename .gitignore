PROJECT/.scrub-list.json
PROJECT/.scrub-log.jsonl
.DS_Store
/temp
temp/rag/
temp/ask-self-rag.env
temp/ask-self*.log
# ask-self index is a LOCAL build artifact, not committed.
# (Switched to Gemini embeddings → the index is no longer key-free portable,
#  so a committed binary buys nothing; each environment reingests with a key.)
ask_self/index/*.sqlite
ask_self/index/*.sqlite-shm
ask_self/index/*.sqlite-wal
ask_self/index/*__events.jsonl
ask_self/index/.DS_Store
# transient scratch from ask-self ingest runs
/ask_self_ingest.out
/ask_self_ingest.err
# generated arch-doc fallback (ARCHITECTURE.md is hand-maintained; ask-self writes here)
/ASK_SELF.md
logs/
__pycache__/
*.pyc
*.pyo
*.egg-info/
rebalance.db
rebalance.db.*.bak
build/
dist/
*.mcpb
~/bin/servers.md
test_report_output.txt
mrt-temp/
rebalance.db-shm
rebalance.db-wal
rebalance.db-wal
/reports
/git-pulse-reports
/git-pulse-sync
/web/pulse.html
/web/*.tmp

# Rendered launchd plists — generated from .plist.template by scripts/install_*_scheduler.sh
scripts/com.rebalance-os.*.plist

# Personal session recovery artifact — can contain anything pasted into chat
snapshot.md
snapshot-archive.md

# Secret / credential files — never commit these
.env
.env.*
*.env
*secrets*
*credentials*
*.pem
*.key
*.p12
/relay

# xyz relay-automation coordination state (per-device, local)
.tick/

# Local beta-test working notes (kept locally, not part of the product)
test-notes/
mrt-temp/
/.claude
